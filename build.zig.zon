.{
    .name = .kabelweb,
    .version = "0.0.0",
    .fingerprint = 0x4af4db419b5a16be,
    .minimum_zig_version = "0.16.0",
    // Zero dependencies — pure Zig server + system-or-vendored libcurl
    // client. Keeps kabelweb consumable as a standalone library.
    .dependencies = .{},
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "scripts",
        // The prebuilt libcurl archives. `vendor/curl/windows-amd64/` is a REAL
        // libcurl (Schannel, no OpenSSL) committed on purpose: kabelweb is
        // consumed by URL + hash, and a `.paths` list that omits `vendor` makes
        // the archive invisible to every consumer — which is exactly how the
        // Windows build ended up linking a no-op stub for months.
        "vendor",
        "README.md",
    },
}
