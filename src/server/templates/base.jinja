<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{% block title %}GinwaServer Demo{% endblock %}</title>
  <style>
    :root {
      --bg: #0f172a;
      --panel: #1e293b;
      --accent: #22d3ee;
      --text: #e2e8f0;
      --muted: #94a3b8;
    }
    * { box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
      background: var(--bg); color: var(--text);
      margin: 0; min-height: 100vh; line-height: 1.6;
    }
    .container { max-width: 720px; margin: 0 auto; padding: 40px 24px; }
    nav { background: var(--panel); padding: 16px 24px; border-bottom: 2px solid var(--accent); }
    nav a { color: var(--accent); text-decoration: none; margin-right: 16px; }
    h1 { color: var(--accent); }
    .feature { background: var(--panel); padding: 16px; margin: 12px 0; border-radius: 8px; }
    .feature h2 { margin: 0 0 8px; font-size: 18px; }
    .feature p { margin: 0; color: var(--muted); }
    .footer { color: var(--muted); font-size: 14px; margin-top: 32px; }
  </style>
</head>
<body>
  <nav><a href="/">Home</a><a href="/example">Jinja Example</a></nav>
  <div class="container">
    {% block content %}{% endblock %}
  </div>
</body>
</html>